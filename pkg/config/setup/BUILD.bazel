load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

# Files generated by `dda inv schema.codegen --keep-orig-order --fix`.
# They are gitignored and produced at build time by :codegen_settings below.
# `other_settings.go` captures any schema settings not covered by a named
# function; it is always emitted (possibly with an empty body) when
# --keep-orig-order is used.
_SETTINGS_FILES = [
    "apm_settings.go",
    "common_settings.go",
    "multi_region_failover_settings.go",
    "other_settings.go",
    "otlp_settings.go",
    "privateactionrunner_settings.go",
    "process_settings.go",
    "system_probe_settings.go",
]

# Invoke the same code-generation logic as
#   dda inv schema.codegen --keep-orig-order --fix
# but write outputs to the Bazel output tree (gen/) instead of the source
# tree.  Inputs are the merged schema YAML files and the existing
# *_settings.go source files (used as ordering hints for --keep-orig-order).
# Re-runs automatically whenever any input changes.
run_binary(
    name = "codegen_settings",
    srcs = [
        # Schema YAML files that drive code generation
        "//pkg/config/schema:yaml/core_schema.yaml",
        "//pkg/config/schema:core_schema_subfiles",
        "//pkg/config/schema:system_probe_schema_subfiles",  # includes system-probe_schema.yaml
        # Existing *_settings.go files: provide function-to-file ordering hints
        "apm_settings.go",
        "common_settings.go",
        "multi_region_failover_settings.go",
        "otlp_settings.go",
        "privateactionrunner_settings.go",
        "process_settings.go",
        "system_probe_settings.go",
    ],
    outs = ["gen/" + f for f in _SETTINGS_FILES],
    args = ["$(RULEDIR)/gen"],
    tool = "//tasks/schema:codegen_settings_main",
)

go_library(
    name = "setup",
    srcs = [
        ":codegen_settings",  # generated *_settings.go files (see above)
        "config.go",
        "config_accessor.go",
        "config_change_checker.go",
        "config_darwin.go",
        "config_init.go",
        "config_init_serverless.go",
        "config_nix.go",
        "config_test_accessor.go",
        "config_windows.go",
        "fixup_init.go",
        "generated.go",
        "ipc_address.go",
        "otlp.go",
        "privateactionrunner.go",
        "process.go",
        "security_agent.go",
        "standard_names.go",
        "system_probe.go",
        "test_config_accessor.go",
        "test_helpers.go",
        "unexpectedunicodefinder.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/config/setup",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/delegatedauth/api/cloudauth/config",
        "//comp/core/delegatedauth/common",
        "//comp/core/delegatedauth/def",
        "//comp/core/secrets/def",
        "//pkg/collector/check/defaults",
        "//pkg/config/create",
        "//pkg/config/env",
        "//pkg/config/helper",
        "//pkg/config/model",
        "//pkg/config/setup/constants",
        "//pkg/config/structure",
        "//pkg/fips",
        "//pkg/util/defaultpaths",
        "//pkg/util/log",
        "//pkg/util/scrubber",
        "//pkg/util/system",
        "@in_yaml_go_yaml_v2//:yaml",
    ] + select({
        "@rules_go//go/platform:windows": [
            "//pkg/util/winutil",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "setup_test",
    srcs = [
        "config_change_checker_test.go",
        "config_secret_test.go",
        "config_test.go",
        "ipc_address_test.go",
        "privateactionrunner_test.go",
        "process_test.go",
        "system_probe_test.go",
        "unexpectedunicodefinder_test.go",
    ],
    embed = [":setup"],
    deps = [
        "//comp/core/delegatedauth/mock",
        "//comp/core/secrets/mock",
        "//pkg/config/model",
        "//pkg/config/nodetreemodel",
        "//pkg/util/defaultpaths",
        "//pkg/util/scrubber",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@in_yaml_go_yaml_v2//:yaml",
    ],
)
